<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_trip_fuel_post_wizard_form" model="ir.ui.view">
        <field name="name">fleet.trip.fuel.post.wizard.form</field>
        <field name="model">fleet.trip.fuel.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Post Fuel Expense">
                <div class="alert alert-warning" role="alert">
                    Please verify the Details below before posting.
                </div>
                <group>
                    <group>
                        <field name="fuel_id" invisible="1"/>
                        <field name="trip_id"/>
                        <field name="product_id"/>
                        <label for="quantity"/>
                        <div class="o_row"><field name="quantity"/><field name="uom_id"/></div>
                        <field name="unit_cost"/>
                        <field name="total_value"/>
                        <field name="location_id" options="{'no_create': True}"/>
                        <field name="available_qty"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="expense_account_id"/>
                        <field name="stock_account_id"/>
                        <field name="journal_id" options="{'no_create': True}"/>
                        <field name="date"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Issue Fuel &amp; Post" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
